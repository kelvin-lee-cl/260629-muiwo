rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{authUid} {
      allow read, write: if request.auth != null && request.auth.uid == authUid;
    }

    match /booths/{boothId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /adminHelpers/{email} {
      allow read, write: if false;
    }

    match /visits/{visitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authUid;
      allow update, delete: if false;
    }

    match /rateLimits/{studentId} {
      allow read, write: if false;
    }

    match /checkpointQuizAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /event/status {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /studentWorks/{workId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.authUid;
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
