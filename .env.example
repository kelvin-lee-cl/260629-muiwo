# Firebase client (public — safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin (server-side only — never expose to the client)
# Paste the full service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Super admin access (server-side only — full access including Event Controls)
ADMIN_SUPER_EMAILS=kelvinlee@futureleadersunion.com,kathytam@futureleadersunion.com

# Optional: seed helper accounts on first load (comma-separated)
ADMIN_INITIAL_HELPERS=leekelvincl@gmail.com

# Optional: extra Google Workspace domains for helpers (default includes futureleadersunion.com)
# ADMIN_HELPER_ALLOWED_DOMAINS=futureleadersunion.com

# ── AI (see shared/aiProviders.ts for full provider config) ──────────────────
# Vercel: URL of the Render AI worker (browser calls this directly)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:10000

# Render / server/.env only — do NOT add API keys here (they stay on the AI worker):
#   RECRAFT_API_KEY      — text-to-image (Recraft)
#   DEEPSEEK_API_KEY     — text generation (DeepSeek)
#   SEEDANCE_API_KEY     — image-to-video (Seedance 2.0 / Volcengine Ark)
#   SEEDANCE_API_BASE_URL, SEEDANCE_MODEL — optional overrides
#   FIREBASE_SERVICE_ACCOUNT, CORS_ORIGIN — see server/.env.example
