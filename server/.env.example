# AI provider keys — set on Render (production) or copy to server/.env (local dev).
# Provider definitions: shared/aiProviders.ts

# Recraft — text-to-image (https://www.recraft.ai/)
RECRAFT_API_KEY=your-recraft-api-key

# DeepSeek — text generation (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Seedance 2.0 — image-to-video via Volcengine Ark (https://seed.bytedance.com/en/seedance2_0)
SEEDANCE_API_KEY=your-volcengine-ark-api-key
# Optional overrides:
# SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL=doubao-seedance-2-0-260128

# Auth + CORS for the AI worker
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}
CORS_ORIGIN=http://localhost:3001,https://260629-muiwo.vercel.app
PORT=10000
